{
    // Copy this file to .vscode/launch.json and customize it locally
    // This file is a template and is not used directly by VSCode

    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run photo-processor (cores)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.run",
            "args": [
                "cores",
                "--input", "data/cores",
                "--output", "data/output"
            ],
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/bin/python3"
        },
        {
            "name": "Python: Run photo-processor (cuttings)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.run",
            "args": [
                "cuttings",
                "--input", "data/cuttings",
                "--output", "data/output"
            ],
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/bin/python3"
        },
        {
            "name": "Python: Run pytests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/"
            ],
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/bin/python3"
        },
        {
            "name": "Python: Run pytests with coverage",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "--cov=src",
                "tests/"
            ],
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "python": "${workspaceFolder}/.venv/bin/python3"
        }
    ]
}
